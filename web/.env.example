# Copy to .env.local, or run `npm run env:setup` to create it. Never commit real values.

# The application's database. Locally this is the Docker container.
# In Vercel it is Neon's POOLED connection string.
DATABASE_URL=postgres://throne:throne@localhost:54329/iron_throne

# Used only for migrations. In Vercel and CI it is Neon's DIRECT connection string.
DATABASE_URL_DIRECT=postgres://throne:throne@localhost:54329/iron_throne

# Local only: the Neon strings, used by `npm run db:check` and nothing else.
NEON_DATABASE_URL=
NEON_DATABASE_URL_DIRECT=

# Signs and encrypts organizer sessions (Better Auth's secret). 32 random bytes, base64url.
SESSION_KEY=

# The address organizers use: http://localhost:3000 locally, the production address in
# Vercel. Vercel's own preview addresses are allowed as well (src/lib/auth.ts).
BETTER_AUTH_URL=http://localhost:3000

# Whether new organizers may create accounts: "open" or "closed". Unset, it is open in
# development and CLOSED in production, so a deployment opens registration on purpose.
ORGANIZER_SIGNUP=

# Protects the retention endpoint. Vercel sends it as a Bearer token to cron jobs.
CRON_SECRET=
