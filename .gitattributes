# Text files are stored and checked out with LF on every machine, Windows included,
# so a fresh checkout matches what was committed byte for byte (the asset tests compare
# hashes) and passes the format check.
* text=auto eol=lf

# Binary files are never touched.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.dump binary
*.webm binary
*.mp3 binary
*.wav binary
